<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="[%d{HH:mm:ss}] [%-5level] [%-16t] [%c{1}:%L] %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="OFF">   <!-- OFF during tests -->
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>